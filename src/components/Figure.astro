---
/**
 * Figure — a captioned research image with attribution.
 * Used for open-access (CC-BY) figures, whose license requires credit.
 */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption: string;
  credit: string;      // attribution text (e.g. authors, year)
  creditUrl?: string;  // DOI / source link
}
const { src, alt, width, height, caption, credit, creditUrl } = Astro.props;
---

<figure class="card overflow-hidden">
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    class="w-full bg-white object-contain"
    loading="lazy"
  />
  <figcaption class="border-t border-border px-6 py-4 text-sm leading-relaxed text-muted">
    {caption}
    {" "}
    <span class="text-subtle">
      —{" "}
      {
        creditUrl ? (
          <a
            href={creditUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="underline-offset-2 hover:text-primary hover:underline"
          >
            {credit}
          </a>
        ) : (
          credit
        )
      }, CC BY 4.0.
    </span>
  </figcaption>
</figure>
