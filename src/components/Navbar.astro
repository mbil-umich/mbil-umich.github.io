---
/**
 * Navbar — sticky top navigation.
 * Highlights the active route and collapses to a toggle menu on small screens.
 */
import { navLinks, site } from "../config/site";

// Normalize the current path (strip trailing slash) for active-link matching.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
---

<header
  class="sticky top-0 z-40 border-b border-border bg-surface/90 backdrop-blur supports-[backdrop-filter]:bg-surface/80"
  style="box-shadow: var(--shadow-nav)"
>
  <nav class="container-page flex h-16 items-center justify-between gap-4" aria-label="Primary">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-3" aria-label={`${site.shortName} — home`}>
      <img
        src="/logos/mbil-logo.png"
        alt="Musculoskeletal Biomechanics & Imaging Laboratory"
        width="871"
        height="359"
        class="h-9 w-auto sm:h-10"
        loading="eager"
      />
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-1 md:flex">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "relative rounded-md px-3 py-2 text-sm font-medium transition-colors",
                isActive(link.href)
                  ? "text-primary"
                  : "text-muted hover:text-primary",
              ]}
            >
              {link.label}
              {isActive(link.href) && (
                <span class="absolute inset-x-3 -bottom-px h-0.5 rounded-full bg-maize" />
              )}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile toggle -->
    <button
      id="nav-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-muted hover:bg-canvas hover:text-primary md:hidden"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <span class="sr-only">Toggle navigation menu</span>
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden border-t border-border bg-surface md:hidden">
    <ul class="container-page flex flex-col py-2">
      {
        navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "block rounded-md px-3 py-2.5 text-base font-medium transition-colors",
                isActive(link.href)
                  ? "bg-canvas text-primary"
                  : "text-muted hover:bg-canvas hover:text-primary",
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    menu?.classList.toggle("hidden");
  });
</script>
