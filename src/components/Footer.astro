---
/**
 * Footer — university affiliation links, contact, and copyright.
 */
import { site, navLinks, affiliationLinks } from "../config/site";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border bg-surface">
  <div class="container-page py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <!-- Lab identity -->
      <div class="md:col-span-1">
        <img
          src="/logos/mbil-logo.png"
          alt="Musculoskeletal Biomechanics & Imaging Laboratory"
          width="871"
          height="359"
          class="h-11 w-auto"
          loading="lazy"
        />
        <p class="mt-3 text-sm text-subtle">
          {site.parent} · {site.university}<br />
          {site.location}
        </p>
      </div>

      <!-- Site navigation -->
      <div>
        <h2 class="font-sans text-sm font-semibold uppercase tracking-wide text-charcoal">
          Explore
        </h2>
        <ul class="mt-4 space-y-2.5">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-muted underline-offset-4 transition-colors hover:text-primary hover:underline"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- University affiliations -->
      <div>
        <h2 class="font-sans text-sm font-semibold uppercase tracking-wide text-charcoal">
          Affiliations
        </h2>
        <ul class="mt-4 space-y-2.5">
          {
            affiliationLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-sm text-muted underline-offset-4 transition-colors hover:text-primary hover:underline"
                >
                  {link.label}
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                  </svg>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- School of Kinesiology lockup -->
    <div class="mt-10 border-t border-border pt-8">
      <a href="https://kines.umich.edu" target="_blank" rel="noopener noreferrer" class="inline-block">
        <img
          src="/logos/kines-horizontal.png"
          alt="School of Kinesiology, University of Michigan"
          width="1482"
          height="147"
          class="h-9 w-auto"
          loading="lazy"
        />
      </a>
    </div>

    <!-- Bottom bar -->
    <div class="mt-8 flex flex-col gap-3 border-t border-border pt-6 text-sm text-subtle sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} The Regents of the University of Michigan.</p>
      <p>
        <a
          href={`mailto:${site.email}`}
          class="underline-offset-4 transition-colors hover:text-primary hover:underline"
        >
          {site.email}
        </a>
      </p>
    </div>
  </div>
</footer>
