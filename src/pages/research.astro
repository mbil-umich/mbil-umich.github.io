---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Figure from "../components/Figure.astro";

const projects = [
  {
    title: "Shoulder Morbidity After Breast Cancer Treatment",
    summary:
      "Mastectomy, breast reconstruction, and radiation therapy can compromise the strength, stiffness, and mobility of the shoulder. We quantify these neuromuscular and biomechanical changes to understand who is most at risk and why.",
    methods: ["Shoulder biomechanics", "Patient-reported outcomes", "Survivorship"],
  },
  {
    title: "Pectoralis Major Mechanics & Shear-Wave Elastography",
    summary:
      "Using ultrasound shear-wave elastography, we measure the region-specific stiffness and material properties of the pectoralis major in vivo — revealing how the muscle changes with reconstruction, radiotherapy, age, and sex.",
    methods: ["Shear-wave elastography", "Muscle stiffness", "In-vivo imaging"],
  },
  {
    title: "Radiation Dose to Shoulder Musculature",
    summary:
      "We quantify the radiation dose delivered to individual shoulder muscles during breast radiotherapy and link it to later changes in stiffness, pain, and function — informing muscle-sparing treatment planning.",
    methods: ["Radiation dosimetry", "Longitudinal follow-up", "Treatment planning"],
  },
  {
    title: "Wearable Sensors for Shoulder Motion",
    summary:
      "We develop kirigami-inspired sensor patches and machine-learning models to estimate shoulder rotation and abduction, bringing objective movement assessment beyond the laboratory.",
    methods: ["Kirigami sensors", "Machine learning", "Wearable technology"],
  },
  {
    title: "Myofascial Massage Interventions",
    summary:
      "Through a Phase 1 clinical trial, we are testing whether myofascial massage and patient–therapist communication reduce pain and alter tissue stiffness in breast cancer survivors with myofascial pain.",
    methods: ["Clinical trial", "Myofascial therapy", "Pain & stiffness"],
  },
  {
    title: "Neck Muscle Mechanics & Chronic Pain",
    summary:
      "We investigate how chronic neck pain and posture influence the activity and elasticity of the upper trapezius and sternocleidomastoid, including the effects of cervical traction and ergonomic factors.",
    methods: ["Neck biomechanics", "EMG", "Ergonomics"],
  },
];

const approach = [
  {
    step: "01",
    title: "Image",
    body: "Quantify muscle and tissue structure in vivo with ultrasound shear-wave elastography and medical imaging.",
  },
  {
    step: "02",
    title: "Measure",
    body: "Capture shoulder strength, stiffness, and motion with robotic biomechanics, EMG, and wearable sensors.",
  },
  {
    step: "03",
    title: "Link",
    body: "Relate tissue properties and treatment exposures to clinical pain, mobility, and patient-reported function.",
  },
  {
    step: "04",
    title: "Translate",
    body: "Develop better tools to detect impairment early and guide rehabilitation for cancer survivors.",
  },
];

const funding = [
  {
    sponsor: "American Cancer Society",
    title: "Quantifying Outcomes after Prepectoral Implant-Based Breast Reconstruction",
    detail: "Research Scholar Grant",
  },
  {
    sponsor: "NIH / NICHD",
    title:
      "Improving the assessment and diagnosis of shoulder morbidity following mastectomy with breast reconstruction",
    detail: "R03",
  },
  {
    sponsor: "Susan G. Komen",
    title: "Uncovering mechanisms responsible for shoulder morbidity following radiotherapy",
    detail: "Postdoctoral Fellowship",
  },
  {
    sponsor: "NIH (NCCIH / NINDS)",
    title:
      "Effects of myofascial massage and patient–therapist communication on pectoralis major properties",
    detail: "Force-Based Manipulations Research Network — Pilot",
  },
];
---

<BaseLayout
  title="Research"
  description="Research themes and projects of the Musculoskeletal Biomechanics & Imaging Laboratory — shoulder biomechanics, muscle imaging, and cancer survivorship."
>
  <PageHeader
    eyebrow="What we do"
    title="Research"
    lead="Our work sits at the intersection of biomechanics, quantitative imaging, and oncology — understanding how tissue structure shapes shoulder function, and how cancer treatment disrupts it."
  />

  <!-- Approach -->
  <section class="container-page py-20">
    <SectionHeading title="Our Approach" />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        approach.map((item) => (
          <div class="card p-7">
            <p class="font-serif text-3xl font-bold text-maize-600">{item.step}</p>
            <h3 class="mt-3 text-lg font-semibold text-primary">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Imaging feature figure -->
  <section class="border-t border-border bg-surface">
    <div class="container-page py-20">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div>
          <SectionHeading title="Seeing Muscle Stiffness" />
          <p class="mt-6 leading-relaxed text-muted">
            Ultrasound shear-wave elastography lets us map the stiffness of the
            pectoralis major directly in living tissue. Brighter regions indicate
            stiffer muscle. Comparing breast cancer survivors treated with
            different surgical and radiation approaches to healthy controls reveals
            how treatment reshapes the mechanical properties of the muscle — both
            at rest and during contraction.
          </p>
        </div>
        <Figure
          src="/images/swe-pectoralis-maps.jpg"
          alt="Shear-wave elastography stiffness maps of the pectoralis major across breast cancer treatment groups and healthy controls, relaxed and contracted."
          width={750}
          height={350}
          caption="Shear-wave elastography maps of the pectoralis major across treatment groups."
          credit="Lipps et al., Scientific Reports (2019)"
          creditUrl="https://doi.org/10.1038/s41598-019-54100-6"
        />
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="border-t border-border bg-canvas">
    <div class="container-page py-20">
      <SectionHeading title="Research Themes" />
      <div class="mt-12 grid gap-6 md:grid-cols-2">
        {
          projects.map((project) => (
            <article class="card flex flex-col p-7">
              <h3 class="text-xl font-semibold text-primary">{project.title}</h3>
              <p class="mt-3 flex-1 leading-relaxed text-muted">{project.summary}</p>
              <ul class="mt-5 flex flex-wrap gap-2">
                {project.methods.map((method) => (
                  <li class="rounded-full border border-border bg-canvas px-3 py-1 text-xs font-medium text-muted">
                    {method}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Funding -->
  <section class="container-page py-20">
    <SectionHeading title="Selected Funding" />
    <p class="mt-6 max-w-2xl leading-relaxed text-muted">
      Our research has been supported by the American Cancer Society, the National
      Institutes of Health, Susan G. Komen, and the University of Michigan.
    </p>
    <ul class="mt-10 space-y-4">
      {
        funding.map((grant) => (
          <li class="card flex flex-col gap-1 p-6 sm:flex-row sm:items-center sm:justify-between sm:gap-6">
            <div>
              <p class="font-semibold text-charcoal">{grant.title}</p>
              <p class="mt-1 text-sm text-subtle">{grant.detail}</p>
            </div>
            <span class="shrink-0 rounded-full bg-primary/5 px-4 py-1.5 text-sm font-semibold text-primary">
              {grant.sponsor}
            </span>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
