---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ObfuscatedEmail from "../components/ObfuscatedEmail.astro";
import { site } from "../config/site";
---

<BaseLayout
  title="Contact"
  description="Get in touch with the Musculoskeletal Biomechanics & Imaging Laboratory."
>
  <PageHeader
    eyebrow="Get in touch"
    title="Contact"
    lead="We welcome inquiries from prospective students, clinical collaborators, and research partners."
  />

  <section class="container-page py-20">
    <div class="grid gap-12 lg:grid-cols-2">
      <!-- Contact details -->
      <div>
        <SectionHeading title="Reach the Lab" />
        <dl class="mt-10 space-y-8">
          <div class="flex gap-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-canvas text-primary" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
            </span>
            <div>
              <dt class="text-sm font-semibold uppercase tracking-wide text-subtle">Email</dt>
              <dd class="mt-1 text-lg text-primary">
                <ObfuscatedEmail
                  user="dlipps"
                  domain="umich.edu"
                  class="text-primary underline-offset-4 hover:underline"
                />
              </dd>
            </div>
          </div>

          <div class="flex gap-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-canvas text-primary" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
            </span>
            <div>
              <dt class="text-sm font-semibold uppercase tracking-wide text-subtle">Location</dt>
              <dd class="mt-1 leading-relaxed text-charcoal">
                {site.parent}, {site.university}<br />
                {site.address}
              </dd>
            </div>
          </div>

          <div class="flex gap-4">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-canvas text-primary" aria-hidden="true">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
            </span>
            <div>
              <dt class="text-sm font-semibold uppercase tracking-wide text-subtle">Office Hours</dt>
              <dd class="mt-1 leading-relaxed text-charcoal">
                By appointment · Monday–Friday
              </dd>
            </div>
          </div>
        </dl>
      </div>

      <!-- Prospective students -->
      <div>
        <SectionHeading title="Join Us" />
        <div class="mt-10 space-y-6">
          <div class="card p-7">
            <h3 class="text-lg font-semibold text-primary">Prospective Graduate Students</h3>
            <p class="mt-2 leading-relaxed text-muted">
              Students interested in biomechanics and imaging research should apply
              through the
              <a href="https://kines.umich.edu" target="_blank" rel="noopener noreferrer" class="text-primary underline-offset-4 hover:underline">School of Kinesiology</a>
              graduate programs. Please email a CV and a brief statement of research interests.
            </p>
          </div>
          <div class="card p-7">
            <h3 class="text-lg font-semibold text-primary">Undergraduate Researchers</h3>
            <p class="mt-2 leading-relaxed text-muted">
              We host motivated undergraduates for independent study and research
              experiences. Reach out to discuss current openings.
            </p>
          </div>
          <div class="card p-7">
            <h3 class="text-lg font-semibold text-primary">Collaborators</h3>
            <p class="mt-2 leading-relaxed text-muted">
              We partner with clinical and engineering groups on imaging,
              biomechanics, and modeling studies. We'd be glad to explore
              opportunities to work together.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
